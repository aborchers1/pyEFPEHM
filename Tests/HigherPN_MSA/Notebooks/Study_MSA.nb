Cell[CellGroupData[{
Cell["\<\
Study MSA assuming that J = aJ lN[i] + bJ (s1[i]+s2[i]) + cJ(s1[i] - s2[i]) \
and \[Chi] = \[Chi]0 + k\[Chi] (\[Delta]\[Chi] - \[Delta]\[Chi]0)\
\>", "Section",
