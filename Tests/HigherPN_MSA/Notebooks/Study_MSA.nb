       ",", " ", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"s", "[", "i", "]"}], "2"], "->", 
        RowBox[{
         SuperscriptBox["s1", "2"], "+", 
         SuperscriptBox["s2", "2"], "+", 
         RowBox[{"2", "s1s2"}]}]}], " ", ",", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[Delta]s", "[", "i", "]"}], "2"], "->", 
        RowBox[{
         SuperscriptBox["s1", "2"], "+", 
         SuperscriptBox["s2", "2"], "-", 
         RowBox[{"2", "s1s2"}]}]}], " ", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"s", "[", "i", "]"}], " ", 
         RowBox[{"\[Delta]s", "[", "i", "]"}]}], "->", 
        RowBox[{
         SuperscriptBox["s1", "2"], "-", 
         SuperscriptBox["s2", "2"]}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Assumed", " ", "expression", " ", "for", " ", "\[Chi]", 
     RowBox[{"(", "\[Delta]\[Chi]", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Chi]of\[Delta]\[Chi]", "=", 
     RowBox[{"{", 
      RowBox[{"\[Chi]", "->", 
       RowBox[{"\[Chi]0", "+", 
        RowBox[{"k\[Chi]", 
         RowBox[{"(", 
          RowBox[{"\[Delta]\[Chi]", "-", "\[Delta]\[Chi]0"}], ")"}]}]}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Spins", " ", "in", " ", "terms", " ", "of", " ", "perpendicular", " ", 
     "components"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"convert2sperp", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["s1", "2"], "->", 
        RowBox[{
         SuperscriptBox["s1p0", "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"\[Chi]0", "+", "\[Delta]\[Chi]0"}], "2"], ")"}], 
          "2"]}]}], ",", 
       RowBox[{
        SuperscriptBox["s2", "2"], "->", 
        RowBox[{
         SuperscriptBox["s2p0", "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"\[Chi]0", "-", "\[Delta]\[Chi]0"}], "2"], ")"}], 
          "2"]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "\[CapitalDelta]J2", " ", "such", " ", "that", "  ", 
      SuperscriptBox["J", "2"]}], "=", 
