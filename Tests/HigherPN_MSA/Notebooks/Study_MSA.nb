Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "total", " ", "angular", " ", "momentum", " ", "to", " ", 
    "find", " ", "a", " ", "simple", " ", "formula", " ", "for", " ", 
    RowBox[{"s1", ".", "s2"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"J2", "=", 
     RowBox[{
      SuperscriptBox["aJ", "2"], " ", "+", " ", 
      RowBox[{"2", " ", "aJ", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"bJ", " ", "\[Chi]"}], " ", "+", " ", 
         RowBox[{"cJ", " ", "\[Delta]\[Chi]"}]}], ")"}]}], " ", "+", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
