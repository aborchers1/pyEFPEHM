        RowBox[{"(", 
         RowBox[{"bJ", "-", "cJ"}], ")"}], "2"], 
       SuperscriptBox["s2p0", "2"]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["bJ", "2"], "-", 
