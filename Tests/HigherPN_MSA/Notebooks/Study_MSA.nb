         RowBox[{"cJ", " ", "\[Delta]\[Chi]0"}]}], ")"}], "2"], " ", "+", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"bJ", "+", "cJ"}], ")"}], "2"], " ", 
       SuperscriptBox["s1p0", "2"]}], " ", "+", " ", 
      RowBox[{
