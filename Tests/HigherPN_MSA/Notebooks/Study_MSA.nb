Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Expressions", " ", "for", " ", "PN", " ", "coefficients"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"aJPN", "=", 
     RowBox[{
      FractionBox["\[Nu]", "y"], 
