       SuperscriptBox["s1", "2"]}], " ", "+", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"bJ", "-", "cJ"}], ")"}], "2"], " ", 
       SuperscriptBox["s2", "2"]}], "+", " ", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["bJ", "2"], "-", 
         SuperscriptBox["cJ", "2"]}], ")"}], "s1s2"}]}]}], ";"}], 
