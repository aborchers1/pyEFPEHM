Cell[CellGroupData[{

Cell["\<\
Coefficients appearing in J = aJ lN[i] + bJ (s1[i]+s2[i]) + cJ(s1[i] - s2[i]) \
and \[Chi] = \[Chi]0 + k\[Chi] (\[Delta]\[Chi] - \[Delta]\[Chi]0)\
\>", "Subsection",
 CellChangeTimes->{{3.971576298329575*^9, 3.971576308452485*^9}, 
