 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "scalar", " ", "products", " ", "among", " ", 
    "quantities"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"scalarProds", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"lN", "[", "i", "]"}], "2"], "->", "1"}], ",", 
       RowBox[{
