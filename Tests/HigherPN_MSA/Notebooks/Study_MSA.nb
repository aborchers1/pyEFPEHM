              SuperscriptBox["\[Chi]", "2"], "-", 
              FractionBox[
               RowBox[{"s1sq", "+", "s2sq"}], "2"]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["y", "3"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox["121", "32"]}], "+", 
                 FractionBox[
                  RowBox[{"671", " ", "\[Nu]"}], "288"]}], ")"}], " ", 
               "\[Chi]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", 
                  FractionBox["55", "32"]}], "+", 
                 FractionBox[
                  RowBox[{"11", " ", "\[Nu]"}], "288"]}], ")"}], 
               "\[Delta]\[Mu]", " ", "\[Delta]\[Chi]"}], "+", 
              RowBox[{"y", " ", 
               FractionBox[
                RowBox[{"2", "\[Nu]"}], "3"], " ", "s1s2"}]}], ")"}]}]}], 
          ")"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bJPN", "=", 
     RowBox[{
      FractionBox["1", "2"], 
