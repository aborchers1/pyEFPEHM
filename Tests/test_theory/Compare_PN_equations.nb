       RowBox[{"e", "->", 
        RowBox[{"Sqrt", "[", "e2", "]"}]}], ",", 
       RowBox[{"\[Delta]qS", "->", 
        RowBox[{"q1", "+", "q2", "-", "2"}]}], ",", 
       RowBox[{"\[Delta]qA", "->", 
