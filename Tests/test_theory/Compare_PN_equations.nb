           RowBox[{"(", 
            RowBox[{"b6NSEFPE", "+", "b6SOEFPE", "+", "b6SSEFPE"}], ")"}], 
           SuperscriptBox["y", "6"]}]}], ")"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"ReleaseHold", "[", 
       RowBox[{
        SuperscriptBox["y", "2"], 
        RowBox[{"(", 
         RowBox[{"k0EFPE", "+", 
          RowBox[{"k1EFPE", " ", "y"}], " ", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k2NSEFPE", "+", "k2SSavEFPE"}], ")"}], 
           SuperscriptBox["y", "2"]}], "+", 
          RowBox[{"k3EFPE", " ", 
           SuperscriptBox["y", "3"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k4NSEFPE", "+", "k4SSAEFPE"}], ")"}], 
           SuperscriptBox["y", "4"]}]}], ")"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"D\[Delta]\[Lambda]", "=", 
     RowBox[{
      FractionBox["k", 
       RowBox[{"1", "+", "k"}]], 
      SuperscriptBox["y", "3"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"rules", " ", "to", " ", "substitute"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"substrules", "=", 
