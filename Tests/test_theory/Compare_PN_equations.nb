  RowBox[{"(*", 
   RowBox[{"substitution", " ", "rules", " ", "for", " ", "plots"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"substrulesPlot", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Delta]\[Mu]", "->", 
        SqrtBox[
         RowBox[{"1", "-", 
          RowBox[{"4", "\[Nu]"}]}]]}], ",", 
       RowBox[{"sp2", "->", 
        SuperscriptBox["sp", "2"]}], ",", 
       RowBox[{"sp2S", "->", 
        RowBox[{
         SuperscriptBox["s1", "2"], "+", 
         SuperscriptBox["s2", "2"], "-", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[Chi]", "2"], "+", 
           SuperscriptBox["\[Delta]\[Chi]", "2"]}], "2"]}]}], ",", 
       RowBox[{"sp2A", "->", 
        RowBox[{
         SuperscriptBox["s1", "2"], "-", 
         SuperscriptBox["s2", "2"], "-", 
         RowBox[{"\[Chi]", " ", "\[Delta]\[Chi]"}]}]}], ",", 
       RowBox[{"flagTail", "->", "0"}], ",", 
       RowBox[{"\[Delta]qS", "->", "0"}], ",", 
