       RowBox[{"\[Delta]oS", "->", 
        RowBox[{"o1", "+", "o2", "-", "2"}]}], ",", 
       RowBox[{"\[Delta]oA", "->", 
        RowBox[{"o1", "-", "o2"}]}], ",", 
       RowBox[{"flagTail", "->", "1"}], ",", 
       RowBox[{
        SuperscriptBox["\[Delta]\[Chi]", "2"], "->", "\[Delta]\[Chi]2"}], ",", 
