Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "the", " ", "Dy"}], ",", " ", 
    RowBox[{"De2", " ", "and", " ", "D\[Delta]\[Lambda]"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Dy", "=", 
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"ReleaseHold", "[", 
       RowBox[{
        SuperscriptBox["y", "9"], "\[Nu]", 
        RowBox[{"(", 
         RowBox[{"a0EFPE", " ", "+", " ", 
          RowBox[{"a2EFPE", " ", 
           SuperscriptBox["y", "2"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a3NSEFPE", "+", "a3SOEFPE"}], ")"}], 
           SuperscriptBox["y", "3"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a4NSEFPE", " ", "+", " ", "a4SSavEFPE"}], ")"}], 
           SuperscriptBox["y", "4"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a5NSEFPE", "+", "a5SOEFPE"}], ")"}], 
           SuperscriptBox["y", "5"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
            "a6NSEFPE", "+", "a6SOEFPE", "+", "a6SSEFPE", "+", 
             "a6SSpQCEFPE"}], ")"}], 
           SuperscriptBox["y", "6"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
            "a7NSQCEFPE", "+", "a7SOQCEFPE", "+", "a7SSQCEFPE", "+", 
             "a7SSpQCEFPE", "+", "a7SSSQCEFPE"}], ")"}], 
           SuperscriptBox["y", "7"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
            "a8NSQCEFPE", "+", "a8SOQCEFPE", "+", "a8SSQCEFPE", "+", 
             "a8SSpQCEFPE"}], ")"}], 
           SuperscriptBox["y", "8"]}], "+", 
          RowBox[{"a9NSQCEFPE", " ", 
           SuperscriptBox["y", "9"]}]}], ")"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"De2", "=", 
     RowBox[{"ReleaseHold", "[", 
      RowBox[{"ReleaseHold", "[", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["y", "8"]}], "\[Nu]", 
        RowBox[{"(", 
         RowBox[{"b0EFPE", " ", "+", " ", 
          RowBox[{"b2EFPE", " ", 
           SuperscriptBox["y", "2"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b3NSEFPE", "+", "b3SOEFPE"}], ")"}], 
           SuperscriptBox["y", "3"]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b4NSEFPE", " ", "+", " ", "b4SSavEFPE"}], ")"}], 
